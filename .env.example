# --- LLM routing + visibility probes ---
# OpenRouter powers every LLM call (classification, message generation, reply
# classification, report copy) AND the four visibility flagships (ChatGPT,
# Claude, Gemini, Perplexity). One key does all of it. Required.
OPENROUTER_API_KEY=

# --- Visibility probes ---
# SerpAPI for the Google AI Overview probe (the 5th engine in the hybrid check).
# Optional: without it the check runs on the four OpenRouter engines only.
SERPAPI_KEY=

# --- Prospecting and enrichment ---
# Google Places API (New) is the preferred ingest path (official API, no Apify
# credit) — `ingest places` uses it automatically when set, falls back to the
# Apify compass/crawler-google-places actor otherwise.
GOOGLE_PLACES_API_KEY=
APIFY_TOKEN=
COMPANIES_HOUSE_API_KEY=

# Sunbiz (FL company registry via Apify) is a paid, low-yield enrichment path
# — never runs automatically. Set ALLOW_SUNBIZ=1 to deliberately allow it.
ALLOW_SUNBIZ=

# --- Postal channel: PostGrid (current) ---
# Live send, server-side HTML render. Portal template ids are edited visually
# at https://app.postgrid.com/templates and re-uploaded with
# `python scripts/create_postgrid_templates.py` after any HTML change.
POSTGRID_API_KEY=
POSTGRID_TEMPLATE_UK=
POSTGRID_TEMPLATE_US=

# --- Postal channel: Stannp (legacy, superseded by PostGrid above) ---
STANNP_API_KEY=

# --- Airtable import ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Short URL base for letter claim links, e.g. https://antek.link
# Letters render a QR code and short URL as CLAIM_BASE_URL/{claim_code}.
CLAIM_BASE_URL=https://antek.link

# --- Claim pages (claim-site/) ---
# Cloudflare Pages hosting for the free-tease claim + report pages
# (go.antekautomation.com/<slug> and /report/<slug>) and one-off audit
# check pages (go.antekautomation.com/audit/<slug>). Deploy with
# `npx wrangler pages deploy dist --project-name antek-claim --branch main`
# from claim-site/ after `python claim-site/build.py`.
CLAIM_SITE_URL=https://go.antekautomation.com
CAL_LINK=antek-automation/30min
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# US owner enrichment provider (apollo | prospeo) — targeted paid reveal only,
# once a name is already known via the free web-owner scrape below. Never
# used for bulk lookups.
ENRICH_PROVIDER=apollo
PROSPEO_API_KEY=
